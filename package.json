{
  "name": "@cas-tx/fieldboard",
  "version": "0.2.0",
  "description": "Open-source construction project dashboard with traceable metrics and approval workflows",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --preview",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "preview": "tsx server/index.ts --preview",
    "format": "prettier --write src server tests scripts *.json *.ts *.html",
    "backup": "tsx scripts/backup.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "lucide-react": "^1.81.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "openid-client": "^6.9.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
