# Local runs use embedded PostgreSQL at .data/postgres.
PORT=4310
HOST=127.0.0.1
# For a hosted deployment behind an HTTPS reverse proxy:
# NODE_ENV=production
# APP_ORIGIN=https://dashboard.example.com
# SETUP_TOKEN=replace-with-a-long-random-value
# TRUST_PROXY=1
# DATABASE_URL=postgresql://fieldboard:password@127.0.0.1:5432/fieldboard
# Optional: absolute path to ClamAV. Files remain quarantined without it.
# CLAMSCAN_PATH=/usr/bin/clamscan
# Optional private local sample override. Never commit customer data.
# PILOT_FIXTURE=.data/private-pilot.json
# Optional encrypted automatic backups (also used by npm run backup).
# BACKUP_DIR=/private/fieldboard-backups
# BACKUP_KEY=64-hexadecimal-characters-generated-with-openssl-rand-hex-32
# BACKUP_INTERVAL_HOURS=24
# Optional OpenID Connect; identities must be explicitly mapped in Settings.
# OIDC_ISSUER=https://identity.example.com
# OIDC_CLIENT_ID=fieldboard
# OIDC_CLIENT_SECRET=your-provider-secret
# Native Docker scanner bridge (instead of local clamscan):
# CLAMSCAN_PATH=/absolute/path/to/fieldboard/scripts/clamav-docker.mjs
# CLAMAV_CONTAINER=fieldboard-scanner

# Optional report email delivery. Remote SMTP requires TLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_FROM=reports@example.com
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# Enable email-verified public workspace creation only on a configured host.
# ALLOW_SIGNUP=1
# Optional hosted billing. Default open_source includes all dashboard features.
# BILLING_MODE=stripe
# STRIPE_SECRET_KEY=your-stripe-secret
# STRIPE_WEBHOOK_SECRET=your-endpoint-signing-secret
# STRIPE_PRICE_ID=price_your_dashboard_subscription
# STRIPE_ADDITIONAL_PRICE_IDS=price_another_accepted_dashboard_plan
